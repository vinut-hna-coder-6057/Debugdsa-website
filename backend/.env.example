PORT=5000

MONGO_URI=your_mongodb_connection_string
REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:3000

JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
SESSION_SECRET=your_session_secret

JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_secure_password
# Add the deployed frontend origin in the hosting environment. Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000

AI_PROVIDER=ollama

# Local Ollama settings (default for local development)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_MS=60000
# Optional Cloudflare Access service-token credentials (backend only).
# Set both values together; the configured OLLAMA_URL must use HTTPS.
OLLAMA_ACCESS_CLIENT_ID=
OLLAMA_ACCESS_CLIENT_SECRET=

# Optional hosted provider config. Keep the API key on the backend only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

COMPLEXITY_TIMEOUT_MS=8000
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
AI_CACHE_DIR=
AI_RELEVANCE_THRESHOLD=0.14
AI_RATE_LIMIT_MAX=10
AI_MAX_CONCURRENT=2
